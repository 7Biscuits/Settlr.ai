# PayPilot Root Environment Configuration Template
# Copy this to backend/.env and update with your credentials

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://paypilot:paypilot@localhost:5432/paypilot

# Auth
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_12345
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Supabase Storage (Receipts & Proof of Payments)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=receipts

# AI Agent (DeepSeek)
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Voice STT / TTS (Deepgram)
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
