{
  "name": "paypilot",
  "version": "0.1.0",
  "private": true,
  "description": "PayPilot — AI-powered shared-expense and debt-settlement application",
  "scripts": {
    "dev": "yarn dev:backend",
    "dev:backend": "yarn --cwd backend dev",
    "build:backend": "yarn --cwd backend build",
    "test:backend": "yarn --cwd backend test",
    "dev:frontend": "yarn --cwd frontend dev",
    "build:frontend": "yarn --cwd frontend build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
