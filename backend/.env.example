# ==========================================
# PayPilot Backend — Environment Variables
# ==========================================

# Environment Mode
# Allowed values: development | test | production
NODE_ENV=production

# Server Host and Port
PORT=3000
HOST=0.0.0.0

# ------------------------------------------
# 1. PostgreSQL Database
# ------------------------------------------
# Direct PostgreSQL connection string or Supabase Transaction Pooler URL
# e.g., postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Local Docker Postgres: postgresql://paypilot:paypilot@localhost:5432/paypilot
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ------------------------------------------
# 2. Authentication (JWT)
# ------------------------------------------
# In production, JWT_SECRET must be at least 32 characters long
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_12345
JWT_EXPIRES_IN=7d

# ------------------------------------------
# 3. CORS Settings
# ------------------------------------------
# Comma-separated list of allowed web frontend domains (required in production)
CORS_ORIGIN=https://paypilot.app,http://localhost:3000

# ------------------------------------------
# 4. Supabase Storage (Receipt Uploads)
# ------------------------------------------
# Project URL: https://[project-ref].supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase Service Role Key (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Storage bucket name (default: receipts)
SUPABASE_STORAGE_BUCKET=receipts

# ------------------------------------------
# 5. AI Agent (DeepSeek)
# ------------------------------------------
# API Key from https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------
# 6. Voice Engine (Deepgram STT & TTS)
# ------------------------------------------
# API Key from https://console.deepgram.com
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
