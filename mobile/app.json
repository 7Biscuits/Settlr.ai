{
  "expo": {
    "name": "PayPilot",
    "slug": "paypilot",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "paypilot",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paypilot.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PayPilot uses the microphone for voice commands to the AI assistant."
      }
    },
    "android": {
      "package": "com.paypilot.app",
      "permissions": [
        "RECORD_AUDIO",
        "SEND_SMS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "PayPilot uses the microphone for voice commands."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3000"
    }
  }
}
