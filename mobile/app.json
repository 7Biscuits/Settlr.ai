{
  "expo": {
    "name": "PayPilot",
    "slug": "paypilot",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "paypilot",
    "assetBundlePatterns": ["**/*"],
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paypilot.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PayPilot uses the microphone for voice commands to the AI assistant."
      }
    },
    "android": {
      "package": "com.paypilot.app",
      "permissions": [
        "RECORD_AUDIO",
        "SEND_SMS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio"
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3000"
    }
  }
}
